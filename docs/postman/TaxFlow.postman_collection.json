{
  "info": {
    "name": "TaxFlow — fluxo real HTTP/MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar em ordem no Runner, uma iteração. Ambiente isolado docker-compose.postman.yml. Não usar em produção."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Health MySQL e Redis\") {",
          "const run=String(Date.now()); pm.collectionVariables.set(\"run_id\",run);",
          "let base=run.slice(-8).padStart(8,\"0\")+\"0001\";",
          "function digit(s,w){const r=[...s].reduce((a,c,i)=>a+Number(c)*w[i],0)%11; return String(r<2?0:11-r);}",
          "base+=digit(base,[5,4,3,2,9,8,7,6,5,4,3,2]); base+=digit(base,[6,5,4,3,2,9,8,7,6,5,4,3,2]);",
          "pm.collectionVariables.set(\"cnpj\",base);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health MySQL e Redis",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Request ID presente\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.match(/^[0-9a-f-]{36}$/));",
              "pm.test(\"Dependências reais OK\", () => pm.expect(pm.response.json()).to.deep.eql({status:\"ok\",checks:{database:\"ok\",redis:\"ok\"}}));"
            ]
          }
        }
      ]
    },
